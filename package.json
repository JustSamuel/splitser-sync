{
  "name": "splitser-sync",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node src/server.ts",
    "reconcile": "node src/actual.ts",
    "simplefin:setup": "node src/simplefin-setup.ts",
    "test": "node --test test/*.test.ts",
    "check": "pnpm lint && pnpm format && pnpm test",
    "typecheck": "tsc",
    "lint": "pnpm typecheck && node scripts/check-boundaries.ts && node scripts/check-env-docs.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "prepare": "husky"
  },
  "dependencies": {
    "@actual-app/api": "26.11.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^24.19.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0"
  }
}
