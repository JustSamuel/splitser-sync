# Address for the local API. Keep it on localhost unless access is protected.
HOST=127.0.0.1
PORT=8787

# Used only when the saved session expires or is rejected.
SPLITSER_EMAIL=you@example.com
SPLITSER_PASSWORD=replace-me

# Persistent, atomic cookie jar. Mount its parent directory as a Coolify volume.
# Relative paths are resolved from this directory.
COOKIE_FILE=./cookies.txt

SPLITSER_BASE_URL=https://app.splitser.com
SPLITSER_API_VERSION=11
REQUEST_TIMEOUT_MS=30000
LIST_CACHE_TTL_MS=60000
TRANSACTION_CACHE_TTL_MS=300000

# Your Splitser identity and the Actual account/category that mirror it.
SPLITSER_MEMBER_NAME=Your Splitser name
ACTUAL_ACCOUNT=Splitser
ACTUAL_TRACKER_CATEGORY=Advances
ACTUAL_TIMEZONE=Europe/Amsterdam

# Actual server credentials. Reconciliation is read-only unless called with --apply.
ACTUAL_SERVER_URL=https://actual.example.com
ACTUAL_SYNC_ID=your-budget-sync-id
ACTUAL_PASSWORD=replace-me
ACTUAL_ENCRYPTION_PASSWORD=
ACTUAL_DATA_DIR=./.actual-data
# Comma-separated on-budget accounts whose balances must never change.
ACTUAL_BANK_ACCOUNTS=Main checking,Joint checking

# API authentication and optional Coolify scheduling. Use long, random tokens.
# API_TOKEN=replace-me
# RECONCILE_TOKEN=replace-me
# ALLOW_ACTUAL_WRITES=false
# RECONCILE_INTERVAL_MINUTES=60

# Optional: serve Splitser to Actual as a SimpleFIN bank (see README).
# Generate all three with `pnpm simplefin:setup https://your-host`.
# SIMPLEFIN_PUBLIC_URL=https://splitser-sync.example.com
# SIMPLEFIN_ACCESS_SECRET=replace-me
# SIMPLEFIN_CLAIM_TOKEN=remove-after-linking
